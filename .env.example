# Copy to .env (optional). Never commit .env.

# The port the site listens on, on 127.0.0.1 only. Change it if something
# else on this machine already uses 8080.
SITE_PORT=8080

# Only for `docker compose --profile tunnel`, which runs a separate
# cloudflared in Docker. Leave empty when your tunnel already runs on the host.
CLOUDFLARE_TUNNEL_TOKEN=
